[Unit]
Description=NiceVPN OpenVPN 可视化管理系统
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@NICEVPN_ROOT@
EnvironmentFile=-/etc/nicevpn/listen.env
ExecStart="@PYTHON_BIN@" main.py
Restart=on-failure
RestartSec=5

# 停机时只先向主 Python 进程发送 SIGTERM，让应用 shutdown hook
# 主动停止 conntrack 等子进程；若超时，再由 systemd 清理整个 cgroup。
KillMode=mixed
TimeoutStopSec=20s
SendSIGKILL=yes

StandardOutput=journal
StandardError=journal

# 本文件是 daemon 安装模板，由 ./start.sh daemon 写入当前真实代码目录和 Python 路径。
# systemd 仅负责运行 Python 服务；前端构建属于部署动作，不在服务重启时重复执行。

[Install]
WantedBy=multi-user.target
