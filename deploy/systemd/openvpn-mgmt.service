[Unit]
Description=NiceVPN OpenVPN 可视化管理系统
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@NICEVPN_ROOT@
ExecStart="@PYTHON_BIN@" main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# 本文件是 daemon 安装模板，由 ./start.sh daemon 写入当前真实代码目录和 Python 路径。
# systemd 仅负责运行 Python 服务；前端构建属于部署动作，不在服务重启时重复执行。

[Install]
WantedBy=multi-user.target
