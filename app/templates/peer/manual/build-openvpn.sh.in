#!/usr/bin/env bash
set -euo pipefail

OPENVPN_VERSION="2.7.9"
OPENVPN_ROOT_DIR="/opt/openvpn"
OPENVPN_PREFIX="${OPENVPN_ROOT_DIR}/current"
OPENSSL_PREFIX="/usr/local/openssl-1.1.1"
BUILD_ROOT="/usr/local/src/nicevpn-peer-build"
STAGE_ROOT=""

cleanup() {
    if [[ -n "${STAGE_ROOT}" && -d "${STAGE_ROOT}" ]]; then
        rm -rf -- "${STAGE_ROOT}"
    fi
}
trap cleanup EXIT

[[ ! -L "${OPENVPN_ROOT_DIR}" ]] || {
    echo "检测到旧版 /opt/openvpn 根目录软链接，请先执行 NiceVPN 提供的一次性目录调整脚本。" >&2
    exit 1
}
mkdir -p "${BUILD_ROOT}" "${OPENVPN_ROOT_DIR}"
cd "${BUILD_ROOT}"
curl -fL --retry 3 \
    "https://github.com/OpenVPN/openvpn/releases/download/v${OPENVPN_VERSION}/openvpn-${OPENVPN_VERSION}.tar.gz" \
    -o "openvpn-${OPENVPN_VERSION}.tar.gz"
tar -xzf "openvpn-${OPENVPN_VERSION}.tar.gz"
cd "openvpn-${OPENVPN_VERSION}"

if [ -x "${OPENSSL_PREFIX}/bin/openssl" ]; then
    OPENSSL_CFLAGS="-I${OPENSSL_PREFIX}/include"
    OPENSSL_LIBS="-L${OPENSSL_PREFIX}/lib -Wl,-rpath,${OPENSSL_PREFIX}/lib -lssl -lcrypto"
    CPPFLAGS="-I${OPENSSL_PREFIX}/include"
    LDFLAGS="-L${OPENSSL_PREFIX}/lib -Wl,-rpath,${OPENSSL_PREFIX}/lib"
    PKG_CONFIG_PATH="${OPENSSL_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
else
    if ! pkg-config --atleast-version=1.1.1 openssl; then
        echo "系统 OpenSSL 版本低于 1.1.1；请先执行可选的 OpenSSL 编译步骤，或安装受支持的 OpenSSL。" >&2
        exit 1
    fi
    OPENSSL_CFLAGS="$(pkg-config --cflags openssl)"
    OPENSSL_LIBS="$(pkg-config --libs openssl)"
    CPPFLAGS="${CPPFLAGS:-}"
    LDFLAGS="${LDFLAGS:-}"
    PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-}"
fi
export OPENSSL_CFLAGS OPENSSL_LIBS CPPFLAGS LDFLAGS PKG_CONFIG_PATH

./configure \
    --prefix="${OPENVPN_PREFIX}" \
    --disable-dco \
    OPENSSL_CFLAGS="${OPENSSL_CFLAGS}" \
    OPENSSL_LIBS="${OPENSSL_LIBS}"
make -j"$(nproc)"

STAGE_ROOT="$(mktemp -d "${OPENVPN_ROOT_DIR}/.stage.XXXXXX")"
make install DESTDIR="${STAGE_ROOT}"
STAGED_PREFIX="${STAGE_ROOT}${OPENVPN_PREFIX}"
STAGED_BIN="${STAGED_PREFIX}/sbin/openvpn"
[ -x "${STAGED_BIN}" ] || {
    echo "候选 OpenVPN binary 不存在: ${STAGED_BIN}" >&2
    exit 1
}
ACTUAL_VERSION="$("${STAGED_BIN}" --version | sed -n '1{s/.*OpenVPN[[:space:]]\\+\\([0-9][0-9.]*\\).*/\\1/p;}')"
[ "${ACTUAL_VERSION}" = "${OPENVPN_VERSION}" ] || {
    echo "OpenVPN 版本校验失败：期望 ${OPENVPN_VERSION}，实际 ${ACTUAL_VERSION:-unknown}" >&2
    exit 1
}

BINARY_HASH="$(sha256sum "${STAGED_BIN}" | awk '{print $1}')"
RELEASE_ID="${OPENVPN_VERSION}-${BINARY_HASH:0:12}"
RELEASE_DIR="${OPENVPN_ROOT_DIR}/${RELEASE_ID}"
if [ -e "${RELEASE_DIR}" ] || [ -L "${RELEASE_DIR}" ]; then
    [ -x "${RELEASE_DIR}/sbin/openvpn" ] || {
        echo "OpenVPN 版本目录异常，拒绝覆盖: ${RELEASE_DIR}" >&2
        exit 1
    }
    EXISTING_HASH="$(sha256sum "${RELEASE_DIR}/sbin/openvpn" | awk '{print $1}')"
    [ "${EXISTING_HASH}" = "${BINARY_HASH}" ] || {
        echo "同版本 OpenVPN 内容不同，拒绝覆盖: ${RELEASE_DIR}" >&2
        exit 1
    }
else
    mv -T -- "${STAGED_PREFIX}" "${RELEASE_DIR}"
fi

if [ -e "${OPENVPN_PREFIX}" ] && [ ! -L "${OPENVPN_PREFIX}" ]; then
    echo "OpenVPN current 已存在但不是软链接，请先执行一次性目录调整脚本: ${OPENVPN_PREFIX}" >&2
    exit 1
fi
NEW_LINK="${OPENVPN_ROOT_DIR}/.current.link.${BASHPID}"
ln -s "${RELEASE_ID}" "${NEW_LINK}"
mv -Tf -- "${NEW_LINK}" "${OPENVPN_PREFIX}"

for PART in sbin bin share lib lib64 include libexec; do
    [ -d "${OPENVPN_PREFIX}/${PART}" ] || continue
    if [ -L "${OPENVPN_ROOT_DIR}/${PART}" ]; then
        [ "$(readlink -- "${OPENVPN_ROOT_DIR}/${PART}")" = "current/${PART}" ] || {
            echo "OpenVPN 兼容入口指向异常: ${OPENVPN_ROOT_DIR}/${PART}" >&2
            exit 1
        }
    elif [ -e "${OPENVPN_ROOT_DIR}/${PART}" ]; then
        echo "OpenVPN 兼容入口被普通路径占用: ${OPENVPN_ROOT_DIR}/${PART}" >&2
        exit 1
    else
        ln -s "current/${PART}" "${OPENVPN_ROOT_DIR}/${PART}"
    fi
done

"${OPENVPN_PREFIX}/sbin/openvpn" --version | head -n 1
echo "OpenVPN ${OPENVPN_VERSION} 已安装到 ${RELEASE_DIR}；稳定入口：${OPENVPN_PREFIX}"
