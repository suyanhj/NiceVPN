#!/usr/bin/env bash
set -euo pipefail

OPENVPN_VERSION="2.7.9"
OPENVPN_PREFIX="/opt/openvpn"
OPENSSL_PREFIX="/usr/local/openssl-1.1.1"
BUILD_ROOT="/usr/local/src/nicevpn-peer-build"

mkdir -p "${BUILD_ROOT}"
cd "${BUILD_ROOT}"
curl -fL --retry 3 \
    "https://github.com/OpenVPN/openvpn/releases/download/v${OPENVPN_VERSION}/openvpn-${OPENVPN_VERSION}.tar.gz" \
    -o "openvpn-${OPENVPN_VERSION}.tar.gz"
tar -xzf "openvpn-${OPENVPN_VERSION}.tar.gz"
cd "openvpn-${OPENVPN_VERSION}"

if [ -x "${OPENSSL_PREFIX}/bin/openssl" ]; then
    OPENSSL_CFLAGS="-I${OPENSSL_PREFIX}/include"
    OPENSSL_LIBS="-L${OPENSSL_PREFIX}/lib -Wl,-rpath,${OPENSSL_PREFIX}/lib -lssl -lcrypto"
    CPPFLAGS="-I${OPENSSL_PREFIX}/include"
    LDFLAGS="-L${OPENSSL_PREFIX}/lib -Wl,-rpath,${OPENSSL_PREFIX}/lib"
    PKG_CONFIG_PATH="${OPENSSL_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
else
    if ! pkg-config --atleast-version=1.1.1 openssl; then
        echo "系统 OpenSSL 版本低于 1.1.1；请先执行可选的 OpenSSL 编译步骤，或安装受支持的 OpenSSL。" >&2
        exit 1
    fi
    OPENSSL_CFLAGS="$(pkg-config --cflags openssl)"
    OPENSSL_LIBS="$(pkg-config --libs openssl)"
    CPPFLAGS="${CPPFLAGS:-}"
    LDFLAGS="${LDFLAGS:-}"
    PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-}"
fi

export OPENSSL_CFLAGS OPENSSL_LIBS CPPFLAGS LDFLAGS PKG_CONFIG_PATH

./configure \
    --prefix="${OPENVPN_PREFIX}" \
    --disable-dco \
    OPENSSL_CFLAGS="${OPENSSL_CFLAGS}" \
    OPENSSL_LIBS="${OPENSSL_LIBS}"
make -j"$(nproc)"
make install

"${OPENVPN_PREFIX}/sbin/openvpn" --version | head -n 1
